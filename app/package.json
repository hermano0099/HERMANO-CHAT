{
  "name": "hermano-chat",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start --tunnel",
    "start:local": "expo start",
    "android": "expo start --android",
