# Supabase Dashboard > Project Settings > API Keys / Connect
# Usare solo la chiave PUBBLICABILE, mai service_role / secret keys!
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY

# Chiave Google Maps Android limitata a questo package e alle firme release.
GOOGLE_MAPS_ANDROID_API_KEY=

# Contatto privacy pubblico del titolare, mostrato nell’informativa in app.
PRIVACY_CONTACT_EMAIL=
